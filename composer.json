{
    "name": "wowworks/geocoder-php-dadata-provider",
    "description": "Integration with Dadata suggestions API.",
    "keywords": ["dadata", "wowworks", "dadata"],
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Wowworks",
            "email": "it@wowworks.ru"
        }
    ],
    "require": {
        "php": ">=5.6.0",
        "willdurand/geocoder": "^4.2"
    },
    "require-dev": {
        "ext-curl": "*",
        "phpunit/phpunit": "^8.5",
        "squizlabs/php_codesniffer": "3.6.2",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Wowworks\\Dadata\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wowworks\\Dadata\\tests\\": "tests/"
        }
    }
}
